# Copy to .env and fill in. Never commit .env.
# Generate secrets:
#   role passwords (URL-safe, >=60 bits for Neon):  openssl rand -hex 24
#   MASTER_SECRET / KEK_SECRET (32 bytes, base64):
#     python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"

# ---- Docker Compose: database bootstrap (db/init-roles.sh) ----
POSTGRES_SUPERUSER_PASSWORD=
PFA_DB_NAME=pfa
MIGRATION_OWNER_PASSWORD=
APP_SERVICE_PASSWORD=
AUTH_SERVICE_PASSWORD=
STATS_READER_PASSWORD=
AUDIT_READER_PASSWORD=
FX_WRITER_PASSWORD=

# ---- Without Docker / cloud (Render + Neon): full role-specific URLs ----
# Compose builds these from the passwords above. Add ?sslmode=require for Neon.
# A URL without a password (postgresql://migration_owner@host/pfa) satisfies config
# validation in containers that must NOT hold that credential.
DATABASE_URL_MIGRATE=
DATABASE_URL_APP=
DATABASE_URL_AUTH=
DATABASE_URL_STATS=
DATABASE_URL_AUDIT=
# Optional: only the FX refresh job needs it. Unset = web process cannot write rates.
DATABASE_URL_FX=

# ---- Application ----
MASTER_SECRET=
# Optional: separate key-encryption secret (enables KEK rotation, see README).
KEK_SECRET=
APP_ENV=development
APP_TIMEZONE=Asia/Karachi
# Render sets RENDER_EXTERNAL_URL automatically; set this only to override it.
PUBLIC_APP_URL=http://localhost:8000
COOKIE_SECURE=
APP_PORT=8000
RUN_MIGRATIONS=true

# ---- Client IP behind a proxy (rate limiting) ----
# Render: CLIENT_IP_HEADER=CF-Connecting-IP and TRUSTED_PROXY_HOPS=1 (see README).
CLIENT_IP_HEADER=
TRUSTED_PROXY_HOPS=0
FORWARDED_ALLOW_IPS=127.0.0.1

# ---- Email: dev_outbox (development only), smtp, resend or brevo ----
# Render's free tier blocks outbound SMTP: use brevo or resend (HTTPS APIs) there.
EMAIL_MODE=dev_outbox
BREVO_API_KEY=
BREVO_FROM=
RESEND_API_KEY=
RESEND_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Optional AI (OpenAI-compatible). The app works fully without it. ----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
